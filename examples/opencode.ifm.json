{
  "$schema": "https://opencode.ai/config.json",
  "model": "ifm/k2-horizon",
  "providers": {
    "ifm": {
      "name": "IFM",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.ifm.ai/v1",
        "apiKey": "{file:~/.config/opencode/secrets/ifm-api-key}"
      },
      "models": {
        "k2-horizon": {
          "modelID": "IFM/K2-Horizon-375B-A23B",
          "name": "K2 Horizon 375B-A23B (IFM)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["high"]
            }
          },
          "compatibility": {
            "reasoningField": "reasoning_content",
            "requireReasoning": true,
            "maxTokensField": "max_tokens"
          },
          "body": {
            "reasoning_effort": "high",
            "temperature": 1.0,
            "top_p": 0.95
          },
          "limit": {
            "context": 200000,
            "output": 32768
          }
        }
      }
    }
  }
}
